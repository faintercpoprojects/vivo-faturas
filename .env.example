# ==========================================================
# PORTAL VIVO EMPRESAS (MVE)
# ==========================================================
VIVO_URL=https://mve.vivo.com.br/
VIVO_USER=seu.usuario@empresa.com.br
VIVO_PASS=sua-senha

# CNPJs a ignorar (separados por virgula, com ou sem mascara)
CNPJ_IGNORAR=40.810.757/0001-65

# Processar apenas estes CNPJs (opcional; vazio = todos)
CNPJ_SOMENTE=

# ==========================================================
# NAVEGADOR / EXECUCAO
# ==========================================================
HEADLESS=true
SLOW_MO=0
NAV_TIMEOUT=60000
ACTION_TIMEOUT=30000
DOWNLOAD_TIMEOUT=180000
MAX_RETRIES=3
RETRY_BASE_DELAY=2000
CONCURRENCY=1
# Quantos meses de faturas retroativas buscar
MESES_RETROATIVOS=12
DOWNLOAD_DIR=./downloads
STORAGE_STATE=./.auth/state.json
# Reaproveita sessao salva (storageState) entre execucoes
REUSE_SESSION=true

# ==========================================================
# IA (escolha um provider: anthropic | openai)
# ==========================================================
IA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
IA_MAX_CHARS=18000

# ==========================================================
# GOOGLE DRIVE
# Service Account (recomendado) OU OAuth2 refresh token
# ==========================================================
GOOGLE_DRIVE_ENABLED=true
# Caminho do JSON da service account
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# Opcional: impersonar usuario do Workspace (domain-wide delegation)
GOOGLE_IMPERSONATE_USER=
# Alternativa OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID da pasta raiz no Drive onde a arvore sera criada
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Se estiver usando Shared Drive
GOOGLE_DRIVE_ID=

# Apagar arquivos locais apos upload confirmado
LIMPAR_APOS_UPLOAD=true

# ==========================================================
# LOGS
# ==========================================================
LOG_LEVEL=info
LOG_DIR=./logs
